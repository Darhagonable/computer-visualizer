{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Computer Visualizer",
  "version": "0.1.0",
  "identifier": "dev.dar.computer-visualizer",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Computer Visualizer",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
